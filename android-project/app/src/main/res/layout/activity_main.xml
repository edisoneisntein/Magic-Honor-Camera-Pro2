<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    tools:context=".MainActivity">

    <!-- ========================================================= -->
    <!-- CAMERA PREVIEW                                             -->
    <!-- ========================================================= -->

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Vista previa de la cámara"
        android:keepScreenOn="true" />

    <!-- ========================================================= -->
    <!-- TOP STATUS OVERLAY                                         -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="10dp"
            android:background="@android:drawable/presence_online" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Iniciando sensor de hardware..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="Cámara lista · Sensor conectado" />

    </LinearLayout>

    <!-- ========================================================= -->
    <!-- BOTTOM CAMERA CONTROL PANEL                                -->
    <!-- ========================================================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#DD000000"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="20dp">

        <!-- ===================================================== -->
        <!-- PRO CONTROLS                                           -->
        <!-- ===================================================== -->

        <LinearLayout
            android:id="@+id/proControlsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- ================= ISO ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ISO"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtIsoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="72dp"
                    android:gravity="end"
                    android:text="ISO: 100"
                    android:textColor="#FF9500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="ISO: 100" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/sbIso"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="48dp"
                android:contentDescription="Sensibilidad ISO"
                android:max="100"
                android:progress="0" />

            <!-- ============== SHUTTER ================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="OBTURADOR"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtShutterValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="92dp"
                    android:gravity="end"
                    android:text="Obturador: 1/100s"
                    android:textColor="#FF9500"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="Obturador: 1/100s" />

            </LinearLayout>

            <SeekBar
                android:id="@+id/sbShutter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:minHeight="48dp"
                android:contentDescription="Velocidad de obturación"
                android:max="100"
                android:progress="0" />

        </LinearLayout>

        <!-- ===================================================== -->
        <!-- MAIN CAMERA BUTTONS                                   -->
        <!-- ===================================================== -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- ================= PRO ================= -->

            <Button
                android:id="@+id/btnTogglePro"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="12dp"
                android:backgroundTint="#333333"
                android:minHeight="48dp"
                android:text="MODO PRO"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:contentDescription="Activar o desactivar modo profesional" />

            <!-- ================= SHUTTER ================= -->

            <Button
                android:id="@+id/btnCapture"
                android:layout_width="88dp"
                android:layout_height="72dp"
                android:layout_marginStart="4dp"
                android:backgroundTint="#FF9500"
                android:minWidth="88dp"
                android:minHeight="48dp"
                android:text="FOTO"
                android:textAllCaps="true"
                android:textColor="#000000"
                android:textSize="15sp"
                android:textStyle="bold"
                android:contentDescription="Tomar fotografía" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
